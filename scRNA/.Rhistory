ScaleData(verbose = FALSE) %>%
RunPCA(npcs = 20, verbose = FALSE) %>%
RunHarmony("donor", plot_convergence = F) %>%
RunUMAP(reduction = "harmony", dims = 1:20) %>%
FindNeighbors(reduction = "harmony", dims = 1:20) %>%
FindClusters(resolution = 0.7) %>%
identity()
}
